{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamTron",
  "version": "0.1.38",
  "identifier": "com.steamtron.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SteamTron",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/steamtron/artwork/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "publisher": "Krunal Dodiya",
    "copyright": "Copyright © 2026 Krunal Dodiya",
    "homepage": "https://steamtron.vercel.app",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Open-source Steam library, fixes, and managed-game manager",
    "longDescription": "SteamTron manages Steam library entries, per-game fixes, archived builds, managed downloads, Proton runtimes, backups, and SLSsteam integration.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
