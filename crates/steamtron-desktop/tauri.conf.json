{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamTron",
  "version": "0.1.0",
  "identifier": "com.steamtron.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SteamTron",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.local/share/steamtron/artwork/**",
          "$LOCALAPPDATA/SteamTron/artwork/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Steam library and fixes manager",
    "longDescription": "SteamTron manages Steam library entries, per-game fixes, archived builds, and SLSsteam integration.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
